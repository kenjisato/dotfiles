#!/usr/bin/env bash
#
# Deploy this tree on top of the base dotfiles. This is the entry point: the base
# repo never looks for a tree to stack, so composing the two is done here.
#
# Order is the whole mechanism — the base tree is linked first, this one second,
# and the later link replaces the earlier one wherever they share a destination.
#
# Usage:
#   bash etc/deploy [--dry-run]
#   DOTFILES=~/src/dotfiles bash etc/deploy    # base repo elsewhere

set -e

HERE="$(cd "$(dirname "$0")/.." && pwd)"
DOTFILES="${DOTFILES:-$HOME/dotfiles}"

if [ ! -f "$DOTFILES/etc/deploy" ]; then
  echo "Base dotfiles not found at $DOTFILES." >&2
  echo "Set \$DOTFILES to where you cloned it, e.g.:" >&2
  echo "  DOTFILES=~/src/dotfiles bash etc/deploy" >&2
  exit 1
fi

bash "$DOTFILES/etc/deploy" "$@"
echo
bash "$DOTFILES/etc/deploy" --root "$HERE" "$@"

# Anything the base layout cannot express goes here, after both trees are linked.
# Directories that mix config with runtime state are the usual reason: linking the
# whole directory would put a tool's cache inside a git repo, so link the few
# files instead. Leave this empty until you actually need it.
