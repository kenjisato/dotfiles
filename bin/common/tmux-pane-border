#!/usr/bin/env bash
# tmux-pane-border — format a pane's path (+ git branch/status) for pane-border-format.
# Usage: tmux-pane-border <path>
# Called from ~/.tmux.conf:
#   set -g pane-border-format "... #(tmux-pane-border '#{pane_current_path}')"

set -euo pipefail

path="${1:-$PWD}"

# Nerd Font git-branch glyph (U+E0A0) + ahead/behind arrows (U+21E1/U+21E3),
# built from bytes so the source stays ASCII.
glyph="$(printf '\356\202\240')"
aglyph="$(printf '\342\207\241')"   # up   — local ahead of upstream (unpushed)
bglyph="$(printf '\342\207\243')"   # down — upstream ahead (as of last fetch)

# Show $HOME as ~
display="${path/#"$HOME"/~}"

# Branch (or short SHA when detached) + working-tree status + upstream
# divergence, all from ONE `git status -b` call. No network: ahead/behind are
# counted against the local remote-tracking ref (i.e. as of the last fetch).
branch=""
flags=""
ahead="" behind=""
if git -C "$path" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    branch="$(git -C "$path" symbolic-ref --short -q HEAD 2>/dev/null \
        || git -C "$path" rev-parse --short HEAD 2>/dev/null || true)"

    # Flags:  +  staged (index)   !  unstaged edit   ?  untracked
    staged="" unstaged="" untracked=""
    while IFS= read -r line; do
        case "$line" in
            '## '*)
                # Header: "## br...origin/br [ahead 1, behind 2]" — pull the
                # counts out of the bracket (absent when in sync / no upstream).
                case "$line" in *'[ahead '*)  a="${line#*'[ahead '}";  ahead="${a%%[],]*}"  ;; esac
                case "$line" in *'behind '*) b="${line#*'behind '}"; behind="${b%%[]]*}" ;; esac
                ;;
            '??'*) untracked="?" ;;
            *)
                case "${line:0:1}" in [MADRC]) staged="+" ;; esac
                case "${line:1:1}" in [MD]) unstaged="!" ;; esac
                ;;
        esac
    done < <(git -C "$path" status --porcelain -b 2>/dev/null)
    flags="${staged}${unstaged}${untracked}"
fi

if [ -n "$branch" ]; then
    out="#[fg=colour114]${glyph} ${branch}"
    if [ -n "$flags" ]; then
        out="${out} #[fg=colour214][${flags}]"
    fi
    # Ahead = unpushed local commits; behind = upstream moved (last fetch).
    if [ -n "$ahead" ]; then
        out="${out} #[fg=colour81]${aglyph}${ahead}"
    fi
    if [ -n "$behind" ]; then
        out="${out} #[fg=colour203]${bglyph}${behind}"
    fi
    printf '%s  %s ' "$display" "$out"
else
    printf '%s ' "$display"
fi
