#!/bin/bash

set -e

# Host profile (mirrors etc/install.ps1's $DOTFILES_HOST_PROFILE):
#   --profile server  /  DOTFILES_HOST_PROFILE=server
#       Headless box reached only over SSH — pkg/Brewfile skips GUI app casks
#       (keeps CLI formulae, fonts, and R for headless rendering / packages).
#   default (desktop): install everything.
# No reliable "this is a server" auto-detection on macOS, so it is opt-in.
#
# An explicit --profile is remembered in a per-machine marker (dotfiles-private
# reads the same file), so follow-up runs keep the profile without re-passing
# the flag. Precedence: --profile > $DOTFILES_HOST_PROFILE > marker > desktop.
#   bash etc/install --profile server            # switch to server, remembered
#   bash etc/install                             # reuses the saved profile
#   bash etc/install --profile desktop           # forget it (back to default)
#   bash etc/install --profile server --no-save  # server for THIS run only
PROFILE_MARKER="${XDG_CONFIG_HOME:-$HOME/.config}/dotfiles/host-profile"

HOST_PROFILE=""
PROFILE_FROM_FLAG=0
SAVE=""   # empty=auto (save when set via flag); 1=force save; 0=never save
while [ $# -gt 0 ]; do
  case "$1" in
    --profile)   HOST_PROFILE="$2"; PROFILE_FROM_FLAG=1; shift 2 ;;
    --profile=*) HOST_PROFILE="${1#*=}"; PROFILE_FROM_FLAG=1; shift ;;
    --save)      SAVE=1; shift ;;
    --no-save)   SAVE=0; shift ;;
    *) echo "Unknown argument: $1" >&2; exit 2 ;;
  esac
done

# What is currently persisted (desktop == no marker).
SAVED_PROFILE="desktop"
if [ -f "$PROFILE_MARKER" ]; then
  SAVED_PROFILE="$(tr -d '[:space:]' < "$PROFILE_MARKER")"
  [ -z "$SAVED_PROFILE" ] && SAVED_PROFILE="desktop"
fi

# Resolve active profile: flag (already set) > env var > saved marker > desktop.
[ -z "$HOST_PROFILE" ] && HOST_PROFILE="${DOTFILES_HOST_PROFILE:-}"
[ -z "$HOST_PROFILE" ] && HOST_PROFILE="$SAVED_PROFILE"

# Persist an explicitly-chosen profile by default; --no-save opts out. desktop
# is the default, so persisting it means removing the marker (that is how you
# clear a saved server profile). The marker is machine-wide and shared with the
# dotfiles-private installer, so saving here also sets its default.
[ -z "$SAVE" ] && SAVE="$PROFILE_FROM_FLAG"
if [ "$SAVE" = 1 ]; then
  if [ "$HOST_PROFILE" = desktop ]; then
    if [ -f "$PROFILE_MARKER" ]; then
      rm -f "$PROFILE_MARKER"
      echo "Cleared saved host profile ($PROFILE_MARKER) — back to desktop default"
    fi
  else
    mkdir -p "$(dirname "$PROFILE_MARKER")"
    printf '%s\n' "$HOST_PROFILE" > "$PROFILE_MARKER"
    echo "Saved host profile '$HOST_PROFILE' to $PROFILE_MARKER"
  fi
elif [ "$HOST_PROFILE" != "$SAVED_PROFILE" ]; then
  # Transient override (env var or --no-save) not matching what is saved.
  echo "Note: using profile '$HOST_PROFILE' for this run only; saved profile is '$SAVED_PROFILE'."
fi

export DOTFILES_HOST_PROFILE="$HOST_PROFILE"
# Homebrew scrubs non-HOMEBREW_-prefixed env vars before evaluating the
# Brewfile, so forward the profile under a name brew will keep.
export HOMEBREW_DOTFILES_HOST_PROFILE="$HOST_PROFILE"
echo "Host profile: $HOST_PROFILE"

# Install Homebrew
if command -v brew > /dev/null 2>&1; then
  echo "Homebrew is already installed."
else
  echo "Installing Homebrew..."
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi

# Ensure brew is on PATH (needed when Homebrew was just installed above)
if ! command -v brew > /dev/null 2>&1; then
  for prefix in /opt/homebrew /home/linuxbrew/.linuxbrew /usr/local; do
    [ -x "$prefix/bin/brew" ] && eval "$("$prefix/bin/brew" shellenv)" && break
  done
fi

# Install packages from Brewfile
DOTFILES="$(cd "$(dirname "$0")/.." && pwd)"
echo "Installing packages from Brewfile..."
brew bundle --file="$DOTFILES/pkg/Brewfile"

# Keep the Homebrew completion dirs out of compinit's "insecure directories"
# prompt. A group-writable "$(brew --prefix)/share" taints every fpath entry
# under it, and any compinit call lacking -i (e.g. Claude Code's shell-snapshot
# replay) then blocks on a [y/n] prompt. On a single-user install brew runs as
# the owner and doesn't need the group-write bit, so strip it. Guarded to a
# user-owned prefix so we never touch a genuinely shared multi-user install.
brew_share="$(brew --prefix)/share"
if [ -O "$brew_share" ]; then
  chmod g-w,o-w "$brew_share"
fi

# Set zsh as default shell
if [ "${SHELL}" != "$(which zsh)" ]; then
  echo "Changing default shell to zsh..."
  chsh -s "$(which zsh)"
fi

# Install Claude Code via official native installer (early, so a failure in the
# rustup/uv/cargo steps below can't leave the box without Claude Code).
if command -v claude > /dev/null 2>&1; then
  echo "Claude Code is already installed."
else
  echo "Installing Claude Code..."
  curl -fsSL https://claude.ai/install.sh | bash
fi

# Install Rust via rustup
if command -v rustup > /dev/null 2>&1; then
  echo "Rust is already installed."
else
  echo "Installing Rust..."
  # --no-modify-path: ~/.zshenv etc. are symlinks into this repo and already
  # source ~/.cargo/env, so let rustup install the toolchain but not touch rc files.
  curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --no-modify-path
fi

# Install uv (Python package manager)
if command -v uv > /dev/null 2>&1; then
  echo "uv is already installed."
else
  echo "Installing uv..."
  # INSTALLER_NO_MODIFY_PATH: rc files are repo symlinks and ~/.local/bin is
  # already on PATH (shell/zsh/.zshenv), so skip the installer's PATH edits.
  curl -LsSf https://astral.sh/uv/install.sh | INSTALLER_NO_MODIFY_PATH=1 sh
fi

# Install Python dev tools via uv
if [ -f "$DOTFILES/pkg/uv-tools.txt" ]; then
  echo "Installing Python dev tools..."
  while IFS= read -r pkg; do
    [ -z "$pkg" ] || [[ "$pkg" == \#* ]] && continue
    uv tool install "$pkg"
  done < "$DOTFILES/pkg/uv-tools.txt"
fi

# Install Rust tools via cargo
if [ -f "$DOTFILES/pkg/cargo-tools.txt" ]; then
  echo "Installing Cargo tools..."
  # rustup may have been installed in this same run — make cargo callable.
  [ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"
  while IFS= read -r pkg; do
    [ -z "$pkg" ] || [[ "$pkg" == \#* ]] && continue
    cargo install "$pkg"
  done < "$DOTFILES/pkg/cargo-tools.txt"
fi

# Wire global git hooks at ~/.config/git/hooks (deployed from
# xdg-config/common/git/hooks/). Idempotent — just sets the value.
echo "Setting core.hooksPath -> ~/.config/git/hooks ..."
git config --global core.hooksPath '~/.config/git/hooks'

# Register gh as git's credential helper. `gh auth login` does not always do
# this (notably on servers set up over SSH), leaving `git push` over HTTPS to
# prompt for a password. `gh auth setup-git` is idempotent, so run it whenever
# gh is present and already authenticated.
if command -v gh > /dev/null 2>&1 && gh auth status > /dev/null 2>&1; then
  echo "Configuring gh as git credential helper..."
  gh auth setup-git
fi

echo "$(tput setaf 2)Install complete!$(tput sgr0)"
echo "Please log out and log back in for the shell change to take effect."