#!/bin/bash

set -e

# Host profile (mirrors etc/install.ps1's $DOTFILES_HOST_PROFILE):
#   --profile server  /  DOTFILES_HOST_PROFILE=server
#       Headless box reached only over SSH — pkg/Brewfile skips GUI app casks
#       (keeps CLI formulae, fonts, and R for headless rendering / packages).
#   default (desktop): install everything.
# No reliable "this is a server" auto-detection on macOS, so it is opt-in.
#
# An explicit --profile is remembered in a per-machine marker (dotfiles-private
# reads the same file), so follow-up runs keep the profile without re-passing
# the flag. Precedence: --profile > $DOTFILES_HOST_PROFILE > marker > desktop.
#   bash etc/install --profile server            # switch to server, remembered
#   bash etc/install                             # reuses the saved profile
#   bash etc/install --profile desktop           # forget it (back to default)
#   bash etc/install --profile server --no-save  # server for THIS run only
PROFILE_MARKER="${XDG_CONFIG_HOME:-$HOME/.config}/dotfiles/host-profile"

HOST_PROFILE=""
PROFILE_FROM_FLAG=0
SAVE=""   # empty=auto (save when set via flag); 1=force save; 0=never save
while [ $# -gt 0 ]; do
  case "$1" in
    --profile)   HOST_PROFILE="$2"; PROFILE_FROM_FLAG=1; shift 2 ;;
    --profile=*) HOST_PROFILE="${1#*=}"; PROFILE_FROM_FLAG=1; shift ;;
    --save)      SAVE=1; shift ;;
    --no-save)   SAVE=0; shift ;;
    *) echo "Unknown argument: $1" >&2; exit 2 ;;
  esac
done

# What is currently persisted (desktop == no marker).
SAVED_PROFILE="desktop"
if [ -f "$PROFILE_MARKER" ]; then
  SAVED_PROFILE="$(tr -d '[:space:]' < "$PROFILE_MARKER")"
  [ -z "$SAVED_PROFILE" ] && SAVED_PROFILE="desktop"
fi

# Resolve active profile: flag (already set) > env var > saved marker > desktop.
[ -z "$HOST_PROFILE" ] && HOST_PROFILE="${DOTFILES_HOST_PROFILE:-}"
[ -z "$HOST_PROFILE" ] && HOST_PROFILE="$SAVED_PROFILE"

# Persist an explicitly-chosen profile by default; --no-save opts out. desktop
# is the default, so persisting it means removing the marker (that is how you
# clear a saved server profile). The marker is machine-wide and shared with the
# dotfiles-private installer, so saving here also sets its default.
[ -z "$SAVE" ] && SAVE="$PROFILE_FROM_FLAG"
if [ "$SAVE" = 1 ]; then
  if [ "$HOST_PROFILE" = desktop ]; then
    if [ -f "$PROFILE_MARKER" ]; then
      rm -f "$PROFILE_MARKER"
      echo "Cleared saved host profile ($PROFILE_MARKER) — back to desktop default"
    fi
  else
    mkdir -p "$(dirname "$PROFILE_MARKER")"
    printf '%s\n' "$HOST_PROFILE" > "$PROFILE_MARKER"
    echo "Saved host profile '$HOST_PROFILE' to $PROFILE_MARKER"
  fi
elif [ "$HOST_PROFILE" != "$SAVED_PROFILE" ]; then
  # Transient override (env var or --no-save) not matching what is saved.
  echo "Note: using profile '$HOST_PROFILE' for this run only; saved profile is '$SAVED_PROFILE'."
fi

export DOTFILES_HOST_PROFILE="$HOST_PROFILE"
# Homebrew scrubs non-HOMEBREW_-prefixed env vars before evaluating the
# Brewfile, so forward the profile under a name brew will keep.
export HOMEBREW_DOTFILES_HOST_PROFILE="$HOST_PROFILE"
echo "Host profile: $HOST_PROFILE"

# Install Homebrew
if command -v brew > /dev/null 2>&1; then
  echo "Homebrew is already installed."
else
  echo "Installing Homebrew..."
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi

# Ensure brew is on PATH (needed when Homebrew was just installed above)
if ! command -v brew > /dev/null 2>&1; then
  for prefix in /opt/homebrew /home/linuxbrew/.linuxbrew /usr/local; do
    [ -x "$prefix/bin/brew" ] && eval "$("$prefix/bin/brew" shellenv)" && break
  done
fi

# Make ~/.local/bin and ~/.cargo/bin callable for the rest of THIS script. uv,
# the Claude Code native installer and rustup all install into one of the two,
# and the steps below either invoke what they just installed or check whether it
# is already present. Being on PATH in a *deployed* shell does not help: this
# installer runs before etc/deploy, usually under bash.
#
# Both failure modes were real. `uv tool install` died with "uv: command not
# found" and set -e took the rest of the installer with it, so the git and gh
# steps at the bottom never ran. And `command -v rustup` always missed, so every
# single run re-downloaded the rustup installer and re-synced the toolchain.
#
# Deliberately not guarded on [ -d ]: on a fresh box these directories do not
# exist yet, and adding them up front is what makes a tool callable immediately
# after the step that creates it.
for dir in "$HOME/.local/bin" "$HOME/.cargo/bin"; do
  case ":$PATH:" in
    *":$dir:"*) ;;
    *) PATH="$dir:$PATH" ;;
  esac
done
unset dir
export PATH

# Install packages from Brewfile
DOTFILES="$(cd "$(dirname "$0")/.." && pwd)"
echo "Installing packages from Brewfile..."
brew bundle --file="$DOTFILES/pkg/Brewfile"

# Keep the Homebrew completion dirs out of compinit's "insecure directories"
# prompt. A group-writable "$(brew --prefix)/share" taints every fpath entry
# under it, and any compinit call lacking -i (e.g. Claude Code's shell-snapshot
# replay) then blocks on a [y/n] prompt. On a single-user install brew runs as
# the owner and doesn't need the group-write bit, so strip it. Guarded to a
# user-owned prefix so we never touch a genuinely shared multi-user install.
brew_share="$(brew --prefix)/share"
if [ -O "$brew_share" ]; then
  chmod g-w,o-w "$brew_share"
fi

# Set zsh as the login shell.
#
# Compare against the passwd entry, NOT $SHELL: $SHELL is inherited from the
# session that spawned this shell, so right after a chsh it still reports the
# old shell. A $SHELL-based check therefore re-runs chsh (and its password
# prompt) on every install until the next logout.
SHELL_CHANGED=0
ZSH_PATH="$(command -v zsh || true)"
if [ -z "$ZSH_PATH" ]; then
  echo "zsh not found; skipping login-shell change."
else
  # getent is Linux-only in practice; fall back to $SHELL elsewhere.
  CURRENT_SHELL="$(getent passwd "$(id -un)" 2>/dev/null | cut -d: -f7)"
  [ -z "$CURRENT_SHELL" ] && CURRENT_SHELL="$SHELL"
  if [ "$CURRENT_SHELL" != "$ZSH_PATH" ]; then
    # chsh refuses any shell missing from /etc/shells — common when zsh comes
    # from Homebrew rather than the system package manager.
    if [ -f /etc/shells ] && ! grep -qxF "$ZSH_PATH" /etc/shells; then
      echo "Adding $ZSH_PATH to /etc/shells (needs sudo)..."
      echo "$ZSH_PATH" | sudo tee -a /etc/shells > /dev/null
    fi
    echo "Changing login shell to $ZSH_PATH..."
    chsh -s "$ZSH_PATH" && SHELL_CHANGED=1
  fi
fi

# Install Claude Code via official native installer (early, so a failure in the
# rustup/uv/cargo steps below can't leave the box without Claude Code).
if command -v claude > /dev/null 2>&1; then
  echo "Claude Code is already installed."
else
  echo "Installing Claude Code..."
  curl -fsSL https://claude.ai/install.sh | bash
fi

# Install Rust via rustup
if command -v rustup > /dev/null 2>&1; then
  echo "Rust is already installed."
else
  echo "Installing Rust..."
  # --no-modify-path: ~/.zshenv etc. are symlinks into this repo and already
  # source ~/.cargo/env, so let rustup install the toolchain but not touch rc files.
  curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --no-modify-path
fi

# Install uv (Python package manager)
if command -v uv > /dev/null 2>&1; then
  echo "uv is already installed."
else
  echo "Installing uv..."
  # INSTALLER_NO_MODIFY_PATH: the rc files are symlinks into this repo and
  # already put ~/.local/bin on PATH, so the installer must not edit them. This
  # script adds that directory to its own PATH above, which is a separate thing.
  curl -LsSf https://astral.sh/uv/install.sh | INSTALLER_NO_MODIFY_PATH=1 sh
fi

# Install Python dev tools via uv.
#
# A failing package must not abort the installer: the git and gh configuration
# at the bottom is what makes a fresh box usable, and it is worth more than any
# single dev tool. Warn and keep going instead.
if [ -f "$DOTFILES/pkg/uv-tools.txt" ]; then
  echo "Installing Python dev tools..."
  while IFS= read -r pkg; do
    [ -z "$pkg" ] || [[ "$pkg" == \#* ]] && continue
    uv tool install "$pkg" || echo "warning: uv tool install '$pkg' failed — continuing." >&2
  done < "$DOTFILES/pkg/uv-tools.txt"
fi

# Install Rust tools via cargo
if [ -f "$DOTFILES/pkg/cargo-tools.txt" ]; then
  echo "Installing Cargo tools..."
  # rustup may have been installed in this same run — make cargo callable.
  [ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"
  while IFS= read -r pkg; do
    [ -z "$pkg" ] || [[ "$pkg" == \#* ]] && continue
    # Non-fatal for the same reason as the uv loop above.
    cargo install "$pkg" || echo "warning: cargo install '$pkg' failed — continuing." >&2
  done < "$DOTFILES/pkg/cargo-tools.txt"
fi

# core.hooksPath (the global gitleaks pre-commit scan) is no longer written to
# ~/.gitconfig from here — it ships in the tracked xdg-config/common/git/config
# that etc/deploy links to ~/.config/git/config. Run `bash etc/deploy` for the
# hook to take effect. (etc/install.ps1 still sets it globally: etc/deploy.ps1
# links only the hook on Windows, not the config file.)

# Register gh as git's credential helper. `gh auth login` does not always do
# this (notably on servers set up over SSH), leaving `git push` over HTTPS to
# prompt for a password. `gh auth setup-git` is idempotent, so run it whenever
# gh is present and already authenticated.
if command -v gh > /dev/null 2>&1 && gh auth status > /dev/null 2>&1; then
  echo "Configuring gh as git credential helper..."
  gh auth setup-git
fi

# A fresh box has no git identity — it is deliberately absent from this public
# repo, and the ~/.config/git/config shipped here carries only non-personal
# settings. Without an identity the first `git commit` dies with "Author
# identity unknown", so surface it now instead of at commit time.
#
# Identity belongs in ~/.gitconfig: that is where `git config --global` writes,
# and it is the file that wins over ~/.config/git/config for single-valued keys,
# so the file that wins and the file you edit stay the same one. The other valid
# home is ~/.config/git/config.local, pulled in by the [include] at the bottom
# of ~/.config/git/config — that is the slot for a private overlay to deploy.
#
# Ordering matters here: README runs `gh auth login` AFTER this installer, so on
# a genuinely first run gh is installed but not yet authenticated and the
# seeding below is skipped by design. Re-running the installer after logging in
# picks it up; the closing message says so.
GIT_IDENTITY_MISSING=0
if [ -z "$(git config --get user.email || true)" ]; then
  GIT_IDENTITY_MISSING=1
  if command -v gh > /dev/null 2>&1 && gh auth status > /dev/null 2>&1; then
    gh_name="$(gh api user --jq .name 2>/dev/null || true)"
    gh_email="$(gh api user --jq .email 2>/dev/null || true)"
    # A gh account with its email hidden reports null, hence the guard.
    if [ -n "$gh_email" ] && [ "$gh_email" != null ]; then
      echo "Setting git identity from the authenticated gh account..."
      if [ -n "$gh_name" ] && [ "$gh_name" != null ]; then
        git config --global user.name "$gh_name"
      fi
      git config --global user.email "$gh_email"
      GIT_IDENTITY_MISSING=0
    fi
  fi
fi

echo "$(tput setaf 2)Install complete!$(tput sgr0)"
if [ "$GIT_IDENTITY_MISSING" = 1 ]; then
  echo
  echo "git has no user.email on this machine, so 'git commit' will fail with"
  echo "\"Author identity unknown\". Fix it either way:"
  echo "  gh auth login && bash etc/install   # a re-run seeds it from your account"
  echo "  git config --global user.name  'Your Name'"
  echo "  git config --global user.email  'you@example.com'"
fi
if [ "$SHELL_CHANGED" = 1 ]; then
  echo
  echo "Login shell is now $ZSH_PATH, but running processes still carry the old"
  echo "\$SHELL. Terminal emulators launch \$SHELL, so a new terminal window is"
  echo "NOT enough — log out of the whole desktop/SSH session (or reboot) first."
fi
