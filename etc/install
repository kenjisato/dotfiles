#!/bin/bash

set -e

# Host profile (mirrors etc/install.ps1's $DOTFILES_HOST_PROFILE):
#   --profile server  /  DOTFILES_HOST_PROFILE=server
#       Headless box reached only over SSH — pkg/Brewfile skips GUI app casks
#       (keeps CLI formulae, fonts, and R for headless rendering / packages).
#   default (desktop): install everything.
# No reliable "this is a server" auto-detection on macOS, so it is opt-in.
HOST_PROFILE="${DOTFILES_HOST_PROFILE:-desktop}"
while [ $# -gt 0 ]; do
  case "$1" in
    --profile)   HOST_PROFILE="$2"; shift 2 ;;
    --profile=*) HOST_PROFILE="${1#*=}"; shift ;;
    *) echo "Unknown argument: $1" >&2; exit 2 ;;
  esac
done
export DOTFILES_HOST_PROFILE="$HOST_PROFILE"
# Homebrew scrubs non-HOMEBREW_-prefixed env vars before evaluating the
# Brewfile, so forward the profile under a name brew will keep.
export HOMEBREW_DOTFILES_HOST_PROFILE="$HOST_PROFILE"
echo "Host profile: $HOST_PROFILE"

# Install Homebrew
if command -v brew > /dev/null 2>&1; then
  echo "Homebrew is already installed."
else
  echo "Installing Homebrew..."
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi

# Ensure brew is on PATH (needed when Homebrew was just installed above)
if ! command -v brew > /dev/null 2>&1; then
  for prefix in /opt/homebrew /home/linuxbrew/.linuxbrew /usr/local; do
    [ -x "$prefix/bin/brew" ] && eval "$("$prefix/bin/brew" shellenv)" && break
  done
fi

# Install packages from Brewfile
DOTFILES="$(cd "$(dirname "$0")/.." && pwd)"
echo "Installing packages from Brewfile..."
brew bundle --file="$DOTFILES/pkg/Brewfile"

# Set zsh as default shell
if [ "${SHELL}" != "$(which zsh)" ]; then
  echo "Changing default shell to zsh..."
  chsh -s "$(which zsh)"
fi

# Install Claude Code via official native installer (early, so a failure in the
# rustup/uv/cargo steps below can't leave the box without Claude Code).
if command -v claude > /dev/null 2>&1; then
  echo "Claude Code is already installed."
else
  echo "Installing Claude Code..."
  curl -fsSL https://claude.ai/install.sh | bash
fi

# Install Rust via rustup
if command -v rustup > /dev/null 2>&1; then
  echo "Rust is already installed."
else
  echo "Installing Rust..."
  # --no-modify-path: ~/.zshenv etc. are symlinks into this repo and already
  # source ~/.cargo/env, so let rustup install the toolchain but not touch rc files.
  curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --no-modify-path
fi

# Install uv (Python package manager)
if command -v uv > /dev/null 2>&1; then
  echo "uv is already installed."
else
  echo "Installing uv..."
  # INSTALLER_NO_MODIFY_PATH: rc files are repo symlinks and ~/.local/bin is
  # already on PATH (shell/zsh/.zshenv), so skip the installer's PATH edits.
  curl -LsSf https://astral.sh/uv/install.sh | INSTALLER_NO_MODIFY_PATH=1 sh
fi

# Install Python dev tools via uv
if [ -f "$DOTFILES/pkg/uv-tools.txt" ]; then
  echo "Installing Python dev tools..."
  while IFS= read -r pkg; do
    [ -z "$pkg" ] || [[ "$pkg" == \#* ]] && continue
    uv tool install "$pkg"
  done < "$DOTFILES/pkg/uv-tools.txt"
fi

# Install Rust tools via cargo
if [ -f "$DOTFILES/pkg/cargo-tools.txt" ]; then
  echo "Installing Cargo tools..."
  # rustup may have been installed in this same run — make cargo callable.
  [ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"
  while IFS= read -r pkg; do
    [ -z "$pkg" ] || [[ "$pkg" == \#* ]] && continue
    cargo install "$pkg"
  done < "$DOTFILES/pkg/cargo-tools.txt"
fi

# Wire global git hooks at ~/.config/git/hooks (deployed from
# xdg-config/common/git/hooks/). Idempotent — just sets the value.
echo "Setting core.hooksPath -> ~/.config/git/hooks ..."
git config --global core.hooksPath '~/.config/git/hooks'

echo "$(tput setaf 2)Install complete!$(tput sgr0)"
echo "Please log out and log back in for the shell change to take effect."