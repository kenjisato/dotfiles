#!/usr/bin/env bash
#
# Symlink dotfiles into $HOME based on the detected OS.
#
# Layout (under $DOTFILES):
#   home/{common,$OS}/*        -> $HOME/*                 (per top-level entry)
#   shell/{zsh,bash,shared}/*  -> $HOME/*                 (per top-level entry)
#   xdg-config/{common,$OS}/   -> $HOME/.config/...       (per FILE, preserving subdirs)
#   bin/{common,$OS}/*         -> $HOME/bin/*             (per file)
#
# $OS is one of: macos, linux, wsl
# Windows: use etc/deploy.ps1 (planned).
#
# Overlay (optional): if $DOTFILES_PRIVATE names a directory that mirrors the
# layout above, the same linking runs against it after this repo, so an overlay
# file wins wherever it shares a destination path. Nothing here requires an
# extension to exist; README's "Extending and overriding" has the slots and the
# rules for adding a set of files without colliding with these.

set -e

DOTFILES="$(cd "$(dirname "$0")/.." && pwd)"

DRY_RUN=0
for arg in "$@"; do
  case "$arg" in
    -n|--dry-run) DRY_RUN=1 ;;
    -h|--help)
      sed -n '3,18p' "$0" | sed 's/^# \?//'
      exit 0 ;;
    *) echo "Unknown option: $arg" >&2; exit 1 ;;
  esac
done

case "$(uname)" in
  Darwin) OS=macos ;;
  Linux)
    if grep -qiE 'microsoft|wsl' /proc/version 2>/dev/null; then
      OS=wsl
    else
      OS=linux
    fi
    ;;
  *) echo "Unsupported OS: $(uname)" >&2; exit 1 ;;
esac

PRIVATE=""
if [ -n "${DOTFILES_PRIVATE:-}" ] && [ -d "$DOTFILES_PRIVATE" ]; then
  PRIVATE="$DOTFILES_PRIVATE"
fi

echo "Detected OS:  $OS"
echo "Source:       $DOTFILES"
[ -n "$PRIVATE" ] && echo "Overlay:      $PRIVATE" || echo "Overlay:      (none — set \$DOTFILES_PRIVATE to add one)"
[ $DRY_RUN -eq 1 ] && echo "(dry-run — no changes will be made)"
echo

# ~/.config and ~/bin must be real directories: this script writes per-file
# symlinks under them, and if either is itself a symlink, the new links land
# inside the symlink's target instead of in $HOME.
for dir in "$HOME/.config" "$HOME/bin"; do
  if [ -L "$dir" ]; then
    cat >&2 <<EOF

ERROR: $dir is a symlink to $(readlink "$dir")

Replace it with a real directory before re-running:

  rm "$dir"
  mkdir "$dir"
  # If $dir is ~/.config, copy live app state back in first:
  #   cp -R ~/.config-backup/* ~/.config/
  bash "$DOTFILES/etc/deploy"

If migrating ~/.config, also remove the stale tree inside the repo:
  rm -rf "$DOTFILES/.config"

EOF
    exit 1
  fi
done

mkdir -p "$HOME/.config" "$HOME/bin"

SKIPPED=()

link() {
  local src="$1" dst="$2"
  [ -e "$src" ] || return 0
  case "$(basename "$src")" in
    .DS_Store|.gitkeep) return 0 ;;
    *.example|*.example.*) return 0 ;;
  esac
  if [ -e "$dst" ] && [ ! -L "$dst" ]; then
    echo "$(tput setaf 3 2>/dev/null)skip $dst (exists and is not a symlink)$(tput sgr0 2>/dev/null)"
    SKIPPED+=("$dst")
    return
  fi
  if [ $DRY_RUN -eq 1 ]; then
    echo "would link: $dst -> $src"
  else
    ln -snfv "$src" "$dst"
  fi
}

# Symlink the immediate children of $1 into directory $2 (per-entry).
link_children() {
  local src_dir="$1" dst_dir="$2"
  [ -d "$src_dir" ] || return 0
  shopt -s nullglob dotglob
  local entry
  for entry in "$src_dir"/*; do
    link "$entry" "$dst_dir/$(basename "$entry")"
  done
  shopt -u nullglob dotglob
}

# Walk every file under $1 and link it into $HOME/.config preserving subdirs.
# Subdirs are created as real directories so apps can write live state alongside
# managed files without polluting the dotfiles repo.
link_xdg_files() {
  local src_root="$1"
  [ -d "$src_root" ] || return 0
  local src rel dst
  while IFS= read -r -d '' src; do
    rel="${src#$src_root/}"
    dst="$HOME/.config/$rel"
    if [ $DRY_RUN -eq 0 ]; then
      mkdir -p "$(dirname "$dst")"
    fi
    link "$src" "$dst"
  done < <(find "$src_root" -type f -print0)
}

deploy_tree() {
  local root="$1"
  link_children  "$root/home/common"        "$HOME"
  link_children  "$root/home/$OS"           "$HOME"
  link_children  "$root/shell/zsh"          "$HOME"
  link_children  "$root/shell/bash"         "$HOME"
  link_children  "$root/shell/shared"       "$HOME"
  link_xdg_files "$root/xdg-config/common"
  link_xdg_files "$root/xdg-config/$OS"
  link_children  "$root/bin/common"         "$HOME/bin"
  link_children  "$root/bin/$OS"            "$HOME/bin"
}

# Guard the ~/.gitconfig invariant before linking anything.
#
# `git config --global` writes to ~/.gitconfig when that file exists, and
# otherwise falls back to $XDG_CONFIG_HOME/git/config — which the next step
# symlinks into this repo. Git follows the symlink and rewrites the *target*, so
# on a box without ~/.gitconfig a plain `git config --global user.email ...`
# silently lands a personal address in a tracked file of this repo.
#
# Creating the file removes the fallback for good: ~/.gitconfig is then both the
# write target and, being read after ~/.config/git/config, the winner for
# single-valued keys. Only ever created, never modified.
ensure_gitconfig() {
  local gc="$HOME/.gitconfig"
  # Spelled out rather than `[ -e ] || [ -L ] && return` — that parses as
  # (A||B)&&C and interacts badly with set -e when the file is absent.
  if [ -e "$gc" ] || [ -L "$gc" ]; then
    return 0
  fi
  if [ $DRY_RUN -eq 1 ]; then
    echo "would create: $gc (keeps 'git config --global' out of this repo)"
    return 0
  fi
  cat > "$gc" <<'EOF'
# Machine-local git config. Untracked on purpose: this is where identity and
# anything else host-specific belongs, and it is what `git config --global`
# edits. Shared, non-personal settings come from ~/.config/git/config, which
# etc/deploy symlinks in from the dotfiles repo.
#
# Git reads ~/.config/git/config first and this file second, so a single-valued
# key set here wins. Created by etc/deploy so that `git config --global` can
# never fall back to writing into a tracked file.
EOF
  echo "created: $gc (keeps 'git config --global' out of this repo)"
}
ensure_gitconfig

echo "--- base ---"
deploy_tree "$DOTFILES"

if [ -n "$PRIVATE" ]; then
  echo
  echo "--- overlay ---"
  deploy_tree "$PRIVATE"
fi

if [ ${#SKIPPED[@]} -gt 0 ]; then
  echo
  echo "$(tput setaf 3 2>/dev/null)Skipped ${#SKIPPED[@]} target(s) — existing non-symlink files were not overwritten:$(tput sgr0 2>/dev/null)"
  for path in "${SKIPPED[@]}"; do
    echo "  $path"
  done
  echo "Remove these manually (rm <path>) and re-run deploy if you want them linked."
fi

echo
echo "$(tput setaf 2 2>/dev/null)Deploy complete!$(tput sgr0 2>/dev/null)"
echo "Open a new shell to load the updated config."
