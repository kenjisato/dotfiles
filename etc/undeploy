#!/usr/bin/env bash
#
# Undeploy dotfiles — remove symlinks in $HOME that point into the given trees.
#
# Scans $HOME (top-level), $HOME/.config (recursive), and $HOME/bin
# (top-level) for symlinks whose target resolves into one of them.
# Regular files are never touched.
#
# Usage:
#   bash etc/undeploy                     # this repo only
#   bash etc/undeploy <dir> [<dir>...]    # these trees instead
#   bash etc/undeploy --also <dir>        # this repo plus another tree
#   bash etc/undeploy --dry-run
#
# Naming the trees is the caller's job: this script has no notion of an
# "overlay" and never goes looking for one. Something that stacked another tree
# on top of this repo is what knows to pass it here as well.

set -e

DOTFILES="$(cd "$(dirname "$0")/.." && pwd)"

DRY_RUN=0
ROOTS=()
for arg in "$@"; do
  case "$arg" in
    -n|--dry-run) DRY_RUN=1 ;;
    -h|--help)
      sed -n '3,13p' "$0" | sed 's/^# \?//'
      exit 0 ;;
    --also) ALSO_NEXT=1 ;;
    -*) echo "Unknown option: $arg" >&2; exit 1 ;;
    *) if [ ! -d "$arg" ]; then echo "Not a directory: $arg" >&2; exit 1; fi
       ROOTS+=("$(cd "$arg" && pwd)") ;;
  esac
done

# No trees named, or only --also given: this repo is the default.
if [ "${#ROOTS[@]}" -eq 0 ] || [ "${ALSO_NEXT:-0}" = 1 ]; then
  ROOTS=("$DOTFILES" "${ROOTS[@]}")
fi

for root in "${ROOTS[@]}"; do
  echo "Tree:         $root"
done
[ $DRY_RUN -eq 1 ] && echo "(dry-run — no changes will be made)"
echo

# Check whether a symlink's target lives inside one of the trees we were given.
points_to_repo() {
  local link="$1"
  local target
  target="$(readlink "$link" 2>/dev/null)" || return 1

  # Resolve relative targets against the link's parent directory.
  if [[ "$target" != /* ]]; then
    target="$(cd "$(dirname "$link")" && cd "$(dirname "$target")" && pwd)/$(basename "$target")"
  fi

  local root
  for root in "${ROOTS[@]}"; do
    case "$target" in
      "$root"/*) return 0 ;;
    esac
  done
  return 1
}

COUNT=0

# Remove a symlink if it points into a managed directory.
maybe_remove() {
  local link="$1"
  [ -L "$link" ] || return 0
  points_to_repo "$link" || return 0

  if [ $DRY_RUN -eq 1 ]; then
    echo "would remove: $link -> $(readlink "$link")"
  else
    echo "remove: $link -> $(readlink "$link")"
    rm "$link"
  fi
  COUNT=$((COUNT + 1))
}

# --- $HOME top-level ---
shopt -s nullglob dotglob
for f in "$HOME"/*; do
  # Skip directories we scan separately.
  case "$(basename "$f")" in
    .config|bin) continue ;;
  esac
  maybe_remove "$f"
done
shopt -u nullglob dotglob

# --- $HOME/.config (recursive — mirrors link_xdg_files) ---
if [ -d "$HOME/.config" ]; then
  while IFS= read -r -d '' f; do
    maybe_remove "$f"
  done < <(find "$HOME/.config" -type l -print0)
fi

# --- $HOME/bin top-level ---
if [ -d "$HOME/bin" ]; then
  shopt -s nullglob dotglob
  for f in "$HOME/bin"/*; do
    maybe_remove "$f"
  done
  shopt -u nullglob dotglob
fi

echo
if [ $COUNT -eq 0 ]; then
  echo "Nothing to remove."
else
  if [ $DRY_RUN -eq 1 ]; then
    echo "Would remove $COUNT symlink(s). Re-run without --dry-run to apply."
  else
    echo "$(tput setaf 2 2>/dev/null)Removed $COUNT symlink(s).$(tput sgr0 2>/dev/null)"
  fi
fi
