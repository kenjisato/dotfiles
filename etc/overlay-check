#!/usr/bin/env bash
#
# Compare two dotfiles trees and report what stacking one on the other would do.
#
# Reports three things, none of them visible by just looking at the trees:
#   1. Collisions — a file in the stacked tree that lands on the same
#      destination as one of ours. Whichever tree is deployed last wins, so a
#      collision means later fixes here stop reaching that machine. This is the
#      one that matters.
#   2. Files deploy would never link: outside the walked paths, or in the wrong
#      per-OS directory.
#   3. Which of the documented extension slots the stacked tree fills.
#
# Usage:
#   bash etc/overlay-check <dir>              # compare <dir> against this repo
#   bash etc/overlay-check <dir> --os macos   # as a different host OS
#   bash etc/overlay-check <dir> --base <dir> # compare two arbitrary trees
#
# Destinations come from `etc/deploy --root <tree> --dry-run`, so this never
# reimplements the mapping and cannot drift from it.
#
# Exit status is 1 when a collision is found, so it can gate a commit.

set -e

DOTFILES="$(cd "$(dirname "$0")/.." && pwd)"

BASE="$DOTFILES"
OVERLAY=""
OS_ARGS=()
while [ $# -gt 0 ]; do
  case "$1" in
    --os)     OS_ARGS=(--os "$2"); shift 2 ;;
    --os=*)   OS_ARGS=(--os "${1#*=}"); shift ;;
    --base)   BASE="$2"; shift 2 ;;
    --base=*) BASE="${1#*=}"; shift ;;
    -h|--help) sed -n '3,21p' "$0" | sed 's/^# \?//'; exit 0 ;;
    -*) echo "Unknown option: $1" >&2; exit 2 ;;
    *) OVERLAY="$1"; shift ;;
  esac
done

if [ -z "$OVERLAY" ]; then
  echo "Usage: bash etc/overlay-check <dir>" >&2
  echo "Nothing is configured anywhere — name the tree you want checked." >&2
  echo "To make one first: bash etc/overlay-init --create" >&2
  exit 2
fi
for d in "$BASE" "$OVERLAY"; do
  [ -d "$d" ] || { echo "Not a directory: $d" >&2; exit 2; }
done
BASE="$(cd "$BASE" && pwd)"
OVERLAY="$(cd "$OVERLAY" && pwd)"
if [ "$BASE" = "$OVERLAY" ]; then
  echo "Both trees are $BASE — nothing to compare." >&2
  exit 2
fi

echo "Base:     $BASE"
echo "Stacked:  $OVERLAY"
echo

TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT

# "would link: <dst> -> <src>" is deploy's own dry-run output, which is why this
# script needs no copy of the layout rules.
emit_map() {
  bash "$DOTFILES/etc/deploy" --root "$1" --dry-run "${OS_ARGS[@]}" \
    | sed -n 's/^would link: \(.*\) -> \(.*\)$/\1\t\2/p'
}
emit_map "$BASE"    | sort > "$TMP/base"
emit_map "$OVERLAY" | sort > "$TMP/over"

tilde() { printf '%s' "$1" | sed "s|^$HOME|~|"; }
rel_to() { printf '%s' "${1#$2/}"; }

# A destination can be a directory (whole subdirectories such as .shell.local are
# linked as one entry), so anything beneath an emitted source is deployed too.
reachable() {
  local file="$1" src
  while IFS=$'\t' read -r _ src; do
    [ -n "$src" ] || continue
    [ "$file" = "$src" ] && return 0
    case "$file" in "$src"/*) return 0 ;; esac
  done < "$TMP/over"
  return 1
}

# ---- 1. collisions -----------------------------------------------------------
collisions=0
while IFS=$'\t' read -r dest src; do
  [ -n "$dest" ] || continue
  base_src="$(awk -F'\t' -v d="$dest" '$1==d {print $2; exit}' "$TMP/base")"
  if [ -n "$base_src" ]; then
    if [ "$collisions" -eq 0 ]; then
      echo "$(tput setaf 1 2>/dev/null)Collisions — deployed last, these replace a file from the base tree:$(tput sgr0 2>/dev/null)"
    fi
    collisions=$((collisions + 1))
    echo "  $(tilde "$dest")"
    echo "      base:     $(rel_to "$base_src" "$BASE")"
    echo "      stacked:  $(rel_to "$src" "$OVERLAY")   <- wins"
  fi
done < "$TMP/over"

if [ "$collisions" -gt 0 ]; then
  echo
  echo "  Rename yours to something the base tree does not track, or move the setting"
  echo "  into one of the extension slots below. Otherwise improvements to the base"
  echo "  file stop reaching any machine using this tree."
  echo
fi

# ---- 2. files that will never be linked --------------------------------------
unreachable=0
while IFS= read -r -d '' src; do
  rel="$(rel_to "$src" "$OVERLAY")"
  case "$rel" in
    .git/*|.gitignore|README.md|etc/*|pkg/*|docs/*|templates/*) continue ;;
  esac
  case "$(basename "$src")" in
    .DS_Store|.gitkeep|*.example|*.example.*) continue ;;
  esac
  if ! reachable "$src"; then
    if [ "$unreachable" -eq 0 ]; then
      echo "$(tput setaf 3 2>/dev/null)Never linked here — outside the walked paths, or the wrong OS directory:$(tput sgr0 2>/dev/null)"
    fi
    unreachable=$((unreachable + 1))
    echo "  $rel"
  fi
done < <(find "$OVERLAY" -type f -not -path "$OVERLAY/.git/*" -print0)
[ "$unreachable" -gt 0 ] && echo

# ---- 3. slots the stacked tree fills ----------------------------------------
echo "Extension slots:"
for slot in \
  "$HOME/.config/git/config.local" \
  "$HOME/.config/lazygit/config.local.yml" \
  "$HOME/.config/cdmarks.local.tsv" \
  "$HOME/.shell.local"; do
  if awk -F'\t' -v d="$slot" '$1==d {found=1} END {exit !found}' "$TMP/over"; then
    echo "  filled   $(tilde "$slot")"
  else
    echo "  empty    $(tilde "$slot")"
  fi
done

echo
echo "$(wc -l < "$TMP/over" | tr -d ' ') destination(s) would be linked from the stacked tree."
if [ "$collisions" -gt 0 ]; then
  echo "$(tput setaf 1 2>/dev/null)$collisions collision(s).$(tput sgr0 2>/dev/null)"
  exit 1
fi
echo "$(tput setaf 2 2>/dev/null)No collisions.$(tput sgr0 2>/dev/null)"
