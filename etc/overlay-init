#!/usr/bin/env bash
#
# Get a tree you can stack on top of this repo: scaffold a new one, or fetch one
# you already keep somewhere, then check it for collisions.
#
# Usage:
#   bash etc/overlay-init --create [<dir>]    # scaffold from templates/overlay
#   bash etc/overlay-init --clone <repo|url>  # clone a remote
#
# Options:
#   --path <dir>   destination for --clone (default: ~/<repo>, or the ghq tree)
#
# <repo|url> takes a full git URL or owner/repo (assumed to be on GitHub).
#
# There is nothing to "configure" and nothing is recorded anywhere: this repo
# never goes looking for a stacked tree. Deploying both is the stacked tree's
# job, and the scaffold ships an etc/deploy that does exactly that. To adopt a
# directory you already have, you do not need this script at all — copy that
# shim in and run `bash etc/overlay-check <dir>`.

set -e

DOTFILES="$(cd "$(dirname "$0")/.." && pwd)"
TEMPLATE="$DOTFILES/templates/overlay"

MODE=""
TARGET=""
DEST=""

while [ $# -gt 0 ]; do
  case "$1" in
    --clone)   MODE="clone";  TARGET="$2"; shift 2 ;;
    --clone=*) MODE="clone";  TARGET="${1#*=}"; shift ;;
    --create)  MODE="create"; shift
               case "${1:-}" in ""|-*) ;; *) DEST="$1"; shift ;; esac ;;
    --path)    DEST="$2"; shift 2 ;;
    --path=*)  DEST="${1#*=}"; shift ;;
    -h|--help) sed -n '3,19p' "$0" | sed 's/^# \?//'; exit 0 ;;
    -*) echo "Unknown option: $1" >&2; exit 2 ;;
    *) echo "Unexpected argument: $1 — use --create or --clone" >&2; exit 2 ;;
  esac
done

if [ -z "$MODE" ]; then
  sed -n '3,19p' "$0" | sed 's/^# \?//'
  exit 2
fi

case "$MODE" in

create)
  [ -n "$DEST" ] || DEST="$HOME/dotfiles-overlay"
  if [ -e "$DEST" ] && [ -n "$(ls -A "$DEST" 2>/dev/null)" ]; then
    echo "$DEST already exists and is not empty." >&2
    echo "Nothing to set up — check the one you have instead:" >&2
    echo "  bash etc/overlay-check \"$DEST\"" >&2
    exit 1
  fi
  [ -d "$TEMPLATE" ] || { echo "Template missing at $TEMPLATE" >&2; exit 1; }
  mkdir -p "$DEST"
  # -a keeps the shim executable; the /. suffix copies contents including dotfiles.
  cp -a "$TEMPLATE/." "$DEST/"
  DEST="$(cd "$DEST" && pwd)"
  echo "Created $DEST from templates/overlay"
  echo
  echo "Next: read $DEST/README.md, then drop the .example suffix from whichever"
  echo "sample files you want, and run 'bash etc/deploy' here."
  ;;

clone)
  [ -n "$TARGET" ] || { echo "--clone needs a repo or URL" >&2; exit 2; }
  command -v git > /dev/null 2>&1 || { echo "git is required" >&2; exit 1; }

  case "$TARGET" in
    *://*|*@*:*) URL="$TARGET" ;;
    */*)         URL="https://github.com/$TARGET.git" ;;
    *) echo "Cannot read '$TARGET' as a repo — use owner/repo or a full URL" >&2; exit 2 ;;
  esac
  NAME="$(basename "${TARGET%.git}")"

  if [ -z "$DEST" ] && command -v ghq > /dev/null 2>&1; then
    # This repo standardises on ghq, so honour its tree when no path was given.
    echo "Cloning with ghq..."
    ghq get "$TARGET"
    matches="$(ghq list --full-path | grep -E "/${NAME}\$" || true)"
    count="$(printf '%s\n' "$matches" | grep -c . || true)"
    if [ "$count" != 1 ]; then
      echo "ghq holds $count repos ending in /$NAME — cannot pick one." >&2
      echo "Re-run with an explicit path: --clone $TARGET --path <dir>" >&2
      exit 1
    fi
    DEST="$matches"
  else
    [ -n "$DEST" ] || DEST="$HOME/$NAME"
    if [ -e "$DEST" ] && [ -n "$(ls -A "$DEST" 2>/dev/null)" ]; then
      echo "$DEST already exists and is not empty — check that one instead:" >&2
      echo "  bash etc/overlay-check \"$DEST\"" >&2
      exit 1
    fi
    echo "Cloning $URL -> $DEST"
    git clone "$URL" "$DEST"
  fi

  DEST="$(cd "$DEST" && pwd)"
  echo "Overlay at $DEST"
  echo
  bash "$DOTFILES/etc/overlay-check" "$DEST" || true
  ;;

esac
