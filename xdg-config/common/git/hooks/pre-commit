#!/bin/sh
#
# Global pre-commit hook. core.hooksPath points here from the deployed
# ~/.config/git/config on macOS/Linux/WSL, and from `git config --global` on
# Windows (etc/deploy.ps1 links only this hook, not that config file).
# Runs on every repo on this machine until/unless bypassed with --no-verify.
#
# Scans staged changes for secret-shaped strings via gitleaks. Not a
# security boundary — bypass is trivial and CI should also scan on push.
# This guard is here to catch *accidents* at commit time.

if ! command -v gitleaks >/dev/null 2>&1; then
    echo "warning: gitleaks not on PATH — staged-secret scan skipped." >&2
    echo "  install: brew install gitleaks  /  winget install Gitleaks.Gitleaks" >&2
    exit 0
fi

# gitleaks 8.19 superseded `protect` with `git`. `protect` still runs in 8.30 but
# is already hidden from --help, so it will eventually go away — and an unknown
# subcommand exits 1, which is indistinguishable from the "leaks found" case
# below and would block every commit with a misleading message. Pick a
# subcommand that actually exists instead of assuming one.
if gitleaks git --help >/dev/null 2>&1; then
    set -- git --staged
else
    set -- protect --staged
fi

gitleaks "$@" --redact --no-banner
rc=$?

if [ "$rc" -eq 0 ]; then
    exit 0
fi

if [ "$rc" -eq 1 ]; then
    cat >&2 <<'EOF'

Commit blocked: gitleaks found a secret-shaped string in staged changes
(report above). Options:

  1) Real secret:    unstage the file, scrub the value, re-add, commit.
                     Rotate the credential — it's been on disk in the
                     staging area.
  2) False positive: add a rule to .gitleaks.toml in this repo (or the
                     global config at ~/.config/gitleaks/gitleaks.toml)
                     and commit it.
  3) Emergency:      git commit --no-verify
                     (use sparingly; CI should scan on push too.)

EOF
    exit 1
fi

echo "warning: gitleaks exited with code $rc — staged-secret scan skipped." >&2
exit 0
